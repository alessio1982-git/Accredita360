{
  "redirects": [
    {
      "source": "/manuale_uso_accredita360(.*)",
      "destination": "https://accredita360s.com/",
      "permanent": true
    },
    {
      "source": "/Manuale_Uso_Accredita360(.*)",
      "destination": "https://accredita360s.com/",
      "permanent": true
    },
    {
      "source": "/manuale(.*)",
      "destination": "https://accredita360s.com/",
      "permanent": true
    },
    {
      "source": "/Manuale(.*)",
      "destination": "https://accredita360s.com/",
      "permanent": true
    },
    {
      "source": "/dossier(.*)",
      "destination": "https://accredita360s.com/",
      "permanent": true
    },
    {
      "source": "/Dossier(.*)",
      "destination": "https://accredita360s.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "accredita360s.vercel.app" }],
      "destination": "https://accredita360s.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/manuale(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/Manuale(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dossier(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/Dossier(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
